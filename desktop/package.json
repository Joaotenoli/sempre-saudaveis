{
  "name": "sempre-saudaveis",
  "productName": "Sempre Saudaveis",
  "version": "1.0.1",
  "description": "Sono, fichas de alimentação e meta de peso.",
  "author": "Sempre Saudáveis",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.joaotenoli.sempresaudaveis",
    "productName": "Sempre Saudaveis",
    "copyright": "Sempre Saudáveis",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js"
    ],
    "icon": "icon.png",
    "afterPack": "./adhoc-sign.js",
    "publish": null,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.healthcare-fitness",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "Sempre Saudáveis"
      }
    },
    "dmg": {
      "artifactName": "SempreSaudaveis-mac-${arch}.dmg",
      "title": "Sempre Saudáveis"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "SempreSaudaveis-windows.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Sempre Saudáveis"
    }
  }
}